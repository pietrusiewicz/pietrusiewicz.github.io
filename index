<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Kacper Pietrusiewicz — administrator systemów Linux</title>
<meta name="description" content="Kacper Pietrusiewicz — administrator systemów Linux: RHEL i Oracle Linux, monitoring (Zabbix), automatyzacja (Ansible), bezpieczeństwo systemów.">
<meta name="theme-color" content="#0e1116">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0e1116;
    --panel: #141922;
    --panel-2: #10151d;
    --line: rgba(255, 255, 255, .09);
    --ink: #e9ecef;
    --muted: #8a929e;
    --accent: #6ee7a0;
    --accent-dim: rgba(110, 231, 160, .12);
    --gold: #e5b567;
    --radius: 22px;
  }

  * { box-sizing: border-box; }

  html, body { margin: 0; padding: 0; }

  body {
    min-height: 100dvh;
    display: grid;
    place-items: center;
    padding: 28px 18px;
    background: var(--bg);
    color: var(--ink);
    font-family: Inter, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    font-size: 16px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  body::before {
    content: "";
    position: fixed;
    inset: -20%;
    background:
      radial-gradient(60% 50% at 22% 12%, rgba(110, 231, 160, .13), transparent 70%),
      radial-gradient(50% 45% at 88% 88%, rgba(229, 181, 103, .10), transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  body::after {
    content: "";
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, .028) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, .028) 1px, transparent 1px);
    background-size: 46px 46px;
    mask-image: radial-gradient(circle at 50% 40%, #000 0%, transparent 78%);
    -webkit-mask-image: radial-gradient(circle at 50% 40%, #000 0%, transparent 78%);
    pointer-events: none;
    z-index: 0;
  }

  .card {
    position: relative;
    z-index: 1;
    width: min(920px, 100%);
    background: linear-gradient(180deg, var(--panel) 0%, var(--panel-2) 100%);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 34px 36px 26px;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, .05) inset,
      0 30px 80px -30px rgba(0, 0, 0, .85);
    animation: rise .7s cubic-bezier(.16, 1, .3, 1) both;
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: none; }
  }

  .prompt {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12.5px;
    color: var(--muted);
    letter-spacing: .01em;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }

  .dots { display: flex; gap: 6px; margin-right: 4px; }
  .dots i {
    width: 9px; height: 9px; border-radius: 50%;
    background: rgba(255, 255, 255, .13);
    display: block;
  }
  .dots i:first-child { background: rgba(255, 95, 86, .55); }
  .dots i:nth-child(2) { background: rgba(255, 189, 46, .5); }
  .dots i:nth-child(3) { background: rgba(39, 201, 63, .45); }

  .prompt b { color: var(--accent); font-weight: 500; }

  .cursor {
    display: inline-block;
    width: 7px; height: 14px;
    background: var(--accent);
    opacity: .85;
    animation: blink 1.15s steps(1) infinite;
    vertical-align: -2px;
  }

  @keyframes blink { 50% { opacity: 0; } }

  .head {
    display: flex;
    align-items: center;
    gap: 18px;
    margin: 26px 0 0;
  }

  .avatar {
    flex: 0 0 auto;
    width: 66px; height: 66px;
    border-radius: 18px;
    display: grid;
    place-items: center;
    font-family: "JetBrains Mono", monospace;
    font-size: 22px;
    font-weight: 500;
    color: #0b1410;
    background: linear-gradient(145deg, var(--accent), #3fb37a);
    box-shadow: 0 10px 26px -10px rgba(110, 231, 160, .6);
    letter-spacing: -.02em;
  }

  h1 {
    margin: 0;
    font-size: clamp(26px, 4.4vw, 38px);
    font-weight: 800;
    letter-spacing: -.03em;
    line-height: 1.1;
  }

  .role {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 14.5px;
  }

  .role span { color: var(--accent); }

  .tagline {
    margin: 22px 0 0;
    font-size: clamp(17px, 2.4vw, 21px);
    line-height: 1.45;
    color: #cfd5dd;
    letter-spacing: -.01em;
    max-width: 60ch;
  }

  .tagline em {
    font-style: normal;
    color: var(--ink);
    box-shadow: inset 0 -.42em 0 var(--accent-dim);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 24px 0 0;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 10px 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 255, 255, .03);
    color: var(--ink);
    font-size: 14px;
    text-decoration: none;
    transition: transform .18s ease, border-color .18s ease, background .18s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .pill:hover, .pill:focus-visible {
    transform: translateY(-2px);
    border-color: rgba(110, 231, 160, .5);
    background: var(--accent-dim);
    outline: none;
  }

  .pill svg { flex: 0 0 auto; opacity: .85; }

  .pill.primary {
    background: var(--accent);
    color: #08130d;
    border-color: transparent;
    font-weight: 600;
  }

  .pill.primary:hover, .pill.primary:focus-visible {
    background: #86f0b2;
    border-color: transparent;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin: 30px 0 0;
  }

  .box {
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 16px 16px 15px;
    background: rgba(255, 255, 255, .018);
  }

  .label {
    display: block;
    font-family: "JetBrains Mono", monospace;
    font-size: 10.5px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 8px;
  }

  .box p { margin: 0; font-size: 13.8px; color: #c6ccd4; }

  .box strong { color: var(--ink); font-weight: 600; }

  .certs {
    margin: 26px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
  }

  .cert {
    font-family: "JetBrains Mono", monospace;
    font-size: 11.5px;
    color: #cbd2db;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 5px 10px;
    background: rgba(255, 255, 255, .025);
    text-decoration: none;
    transition: border-color .18s ease, color .18s ease;
  }

  .cert:hover, .cert:focus-visible {
    border-color: rgba(229, 181, 103, .55);
    color: var(--gold);
    outline: none;
  }

  .cert.soon { color: var(--muted); border-style: dashed; }

  .foot {
    margin: 22px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px;
    font-size: 12.5px;
    color: var(--muted);
    font-family: "JetBrains Mono", monospace;
  }

  .foot .ok { color: var(--accent); }

  @media (max-width: 760px) {
    .card { padding: 26px 20px 20px; border-radius: 18px; }
    .grid { grid-template-columns: 1fr; }
    .head { gap: 14px; }
    .avatar { width: 56px; height: 56px; border-radius: 15px; font-size: 19px; }
    .prompt { font-size: 11.5px; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
</style>
</head>
